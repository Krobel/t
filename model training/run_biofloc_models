def get_candidate_models_and_params():
    models = {
        "LinearRegression": Pipeline(
            [ ("scaler", StandardScaler()), ("model", LinearRegression()) ]
        ),
        "DecisionTree": DecisionTreeRegressor(random_state=42),
        "KNN": Pipeline(
            [ ("scaler", StandardScaler()), ("knn", KNeighborsRegressor()) ]
        ),
        "RandomForest": RandomForestRegressor(
            random_state=42,
            n_jobs=-1
        ),
        "AdaBoost": AdaBoostRegressor(
            random_state=42
        ),
        "XGBoost": XGBRegressor(
            objective="reg:squarederror",
            random_state=42,
            n_jobs=-1
        ),
    }

    param_grids = {
        "LinearRegression": {},
        "DecisionTree": {
            "max_depth": [2, 3, 4, 5, None],
            "min_samples_leaf": [1, 3, 5],
        },
        "KNN": {
            "knn__n_neighbors": [1, 3], # n_neighbors = 5 has been removed as per request
            "knn__weights": ["uniform", "distance"],
        },
        "RandomForest": {
            "n_estimators": [50, 100, 200],
            "max_depth": [3, 5, 7, None],
            "min_samples_leaf": [1, 3, 5],
        },
        "AdaBoost": {
            "n_estimators": [50, 100, 200],
            "learning_rate": [0.01, 0.05, 0.1, 0.5, 1.0],
        },
        "XGBoost": {
            "n_estimators": [50, 100, 200],
            "max_depth": [2, 3, 4],
            "learning_rate": [0.01, 0.05, 0.1],
            "subsample": [0.7, 1.0],
            "colsample_bytree": [0.7, 1.0], # Add colsample_bytree for more comprehensive tuning
        },
    }
    return models, param_grids

def cv_predictions_for_model(model, X, y, n_splits=10, random_state=42):
    """
    K-fold cross-validation for a single model.

    Returns
    -------
    mae, rmse, r2 : floats
    y_true_all : np.ndarray, shape (n_samples,)
    y_pred_all : np.ndarray, shape (n_samples,)
    """
    n_samples = len(y)
    effective_splits = min(n_splits, n_samples)

    if effective_splits < 2:
        raise ValueError("At least 2 samples are required for cross-validation.")

    kf = KFold(n_splits=effective_splits, shuffle=True, random_state=random_state)

    y_true_all = np.array(y, copy=True)
    y_pred_all = np.zeros_like(y_true_all, dtype=float)

    for train_idx, test_idx in kf.split(X):
        X_train, X_test = X[train_idx], X[test_idx]
        y_train = y[train_idx]

        m = clone(model)
        m.fit(X_train, y_train)
        y_pred = m.predict(X_test)

        y_pred_all[test_idx] = y_pred

    mae = mean_absolute_error(y_true_all, y_pred_all)
    mse = mean_squared_error(y_true_all, y_pred_all)
    rmse = np.sqrt(mse)
    r2 = r2_score(y_true_all, y_pred_all)

    return mae, rmse, r2, y_true_all, y_pred_all

def cv_metrics_for_models(models, X, y, n_splits=10, random_state=42):
    results = {}
    for name, model in models.items():
        mae, rmse, r2, _, _ = cv_predictions_for_model(
            model, X, y, n_splits=n_splits, random_state=random_state
        )
        results[name] = {"mae": mae, "rmse": rmse, "r2": r2}
    return results

def loo_evaluation(model, X, y):
    if len(y) < 2:
        raise ValueError("At least 2 samples are required for leave-one-out evaluation.")

    loo = LeaveOneOut()
    y_true_all = []
    y_pred_all = []

    for train_idx, test_idx in loo.split(X):
        X_train, X_test = X[train_idx], X[test_idx]
        y_train, y_test = y[train_idx], y[test_idx]

        m = clone(model)
        m.fit(X_train, y_train)
        y_pred = m.predict(X_test)

        y_true_all.append(y_test[0])
        y_pred_all.append(float(y_pred[0]))

    y_true_all = np.array(y_true_all)
    y_pred_all = np.array(y_pred_all)

    mae = mean_absolute_error(y_true_all, y_pred_all)
    mse = mean_squared_error(y_true_all, y_pred_all)
    rmse = np.sqrt(mse)
    r2 = r2_score(y_true_all, y_pred_all)

    return mae, rmse, r2, y_true_all, y_pred_all

def _format_target_name_for_print(name):
    if "(" in name and ")" in name:
        name = name.replace("(", " (")

    name = name.replace("NO3_B", "NO₃_B")
    name = name.replace("NO2_B", "NO₂_B")

    return name

def run_pipeline_target(df, feature_cols, target_col, n_splits=10, model_overrides=None):
    """
    1. K-fold CV across all models with hyperparameter tuning; choose best by highest R².
    2. LOO evaluation for the best model.
    3. Return metrics and predictions for both CV and LOO.
    """
    sub_df = df[feature_cols + [target_col]].dropna()

    if sub_df.empty:
        raise ValueError(f"No valid rows found for target: {target_col}")

    X = sub_df[feature_cols].values
    y = sub_df[target_col].values

    if len(y) < 2:
        raise ValueError(f"Not enough samples for target: {target_col}")

    base_models, param_grids = get_candidate_models_and_params()
    tuned_models = {}
    cv_metrics = {}
    model_best_params = {} # New: Store best params for each model after tuning

    formatted_target_col = _format_target_name_for_print(target_col)

    print(f"\n--- Running Hyperparameter Tuning for {formatted_target_col} ---")
    for name, model in base_models.items():
        print(f"  Tuning {name}...")
        param_grid = param_grids.get(name, {})

        if param_grid:
            # Use GridSearchCV for hyperparameter tuning
            grid_search = GridSearchCV(
                estimator=model,
                param_grid=param_grid,
                scoring='neg_mean_absolute_error', # Optimize for MAE
                cv=n_splits,
                n_jobs=-1,
                verbose=0
            )
            grid_search.fit(X, y)
            tuned_models[name] = grid_search.best_estimator_
            model_best_params[name] = grid_search.best_params_ # Store best params for this model
            # Evaluate the best estimator from GridSearchCV using cv_predictions_for_model for consistent metrics calculation
            mae, rmse, r2, _, _ = cv_predictions_for_model(
                grid_search.best_estimator_, X, y, n_splits=n_splits, random_state=42
            )
            cv_metrics[name] = {"mae": mae, "rmse": rmse, "r2": r2}
            print(f"    Best params for {name}: {grid_search.best_params_}")
            print(f"    CV MAE for tuned {name}: {-grid_search.best_score_:.3f}") # best_score_ is negative MAE
        else:
            # No tuning, use base model directly
            tuned_models[name] = model
            model_best_params[name] = {} # No params for non-tuned models
            mae, rmse, r2, _, _ = cv_predictions_for_model(
                model, X, y, n_splits=n_splits, random_state=42
            )
            cv_metrics[name] = {"mae": mae, "rmse": rmse, "r2": r2}
            print(f"    No tuning for {name}.")


    print(f"\n10-fold CV mean metrics per model for {formatted_target_col} (after tuning):")
    print("  Model           |  MAE   |  RMSE  |   R²")
    for name, m in sorted(cv_metrics.items(), key=lambda kv: kv[1]["mae"]):
        print(f"  {name:15s} | {m['mae']:6.3f} | {m['rmse']:6.3f} | {m['r2']:6.3f}")

    best_name = min(cv_metrics, key=lambda nm: cv_metrics[nm]["mae"])

    # Apply override if specified for this target
    if model_overrides and target_col in model_overrides:
        preferred_model_name = model_overrides[target_col]
        if preferred_model_name in tuned_models:
            best_name = preferred_model_name
            print(f"    Overriding best model for {formatted_target_col} to: {best_name} (as per request)")
        else:
            print(f"    Warning: Preferred model '{preferred_model_name}' for '{formatted_target_col}' not found in tuned models. Sticking with MAE-best: {best_name}")

    best_model = tuned_models[best_name] # Use the tuned best model
    best_model_params = model_best_params.get(best_name, {}) # Get the best params for the identified best model

    print(f"\nBest model for {formatted_target_col} (by 10-fold MAE): {best_name}")

    mae_cv_best, rmse_cv_best, r2_cv_best, y_true_cv, y_pred_cv = cv_predictions_for_model(
        best_model, X, y, n_splits=n_splits, random_state=42
    )

    print(f"Best model 10-fold CV for {formatted_target_col}:")
    print(f"  MAE  = {mae_cv_best:.3f}")
    print(f"  RMSE = {rmse_cv_best:.3f}")
    print(f"  R²   = {r2_cv_best:.3f}")

    mae_loo, rmse_loo, r2_loo, y_true_loo, y_pred_loo = loo_evaluation(best_model, X, y)

    print(f"LOO performance for {formatted_target_col}:")
    print(f"  MAE  = {mae_loo:.3f}")
    print(f"  RMSE = {rmse_loo:.3f}")
    print(f"  R²   = {r2_loo:.3f}")

    result = {
        "target": target_col,
        "n_samples": len(y),
        "best_model_name": best_name,
        "best_model_params": best_model_params, # Add best_model_params to result
        "cv_metrics": cv_metrics,
        "cv_best_mae": mae_cv_best,
        "cv_best_rmse": rmse_cv_best,
        "cv_best_r2": r2_cv_best,
        "y_true_cv": y_true_cv,
        "y_pred_cv": y_pred_cv,
        "loo_mae": mae_loo,
        "loo_rmse": rmse_loo,
        "loo_r2": r2_loo,
        "y_true_loo": y_true_loo,
        "y_pred_loo": y_pred_loo,
    }
    return result

