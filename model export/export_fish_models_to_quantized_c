    qtrees = [
        xgb_float_nodes_to_quantized_leaf_delta_nodes(
            nodes,
            feature_min,
            feature_step,
            leaf_min,
            leaf_step
        )
        for nodes in float_trees
    ]

    n_trees = len(qtrees)

    base_score = parse_xgb_base_score(estimator)

    lines.append(f"/* Quantized micro XGBoost for {target} */")
    lines.append(f"#define {prefix.upper()}_N_TREES {n_trees}")
    lines.append(f"static const float {prefix}_base_score = {c_float(base_score)};")
    lines.append(f"static const float {prefix}_leaf_min = {c_float(leaf_min)};")
    lines.append(f"static const float {prefix}_leaf_step = {c_float(leaf_step)};")
    lines.append("")

    for i, nodes in enumerate(qtrees):
        write_quant_tree_nodes(lines, f"{prefix}_tree_{i}", nodes)

    lines.append(f"static const FishQTreeNode* const {prefix}_trees[{prefix.upper()}_N_TREES] = {{")

    for i in range(n_trees):
        lines.append(f"    {prefix}_tree_{i},")

    lines.append("};")
    lines.append("")
    lines.append(f"float {fn}(const float input_raw[FISH_N_FEATURES]) {{")
    lines.append(f"    float pred = {prefix}_base_score;")
    lines.append(f"    for (int i = 0; i < {prefix.upper()}_N_TREES; i++) {{")
    lines.append(f"        int16_t leaf_q = fish_eval_q_tree_lt({prefix}_trees[i], input_raw);")
    lines.append(f"        pred += {prefix}_leaf_min + ((float)leaf_q * {prefix}_leaf_step);")
    lines.append("    }")
    lines.append("    if (pred < 0.0f) pred = 0.0f;")
    lines.append("    return pred;")
    lines.append("}")
    lines.append("")


