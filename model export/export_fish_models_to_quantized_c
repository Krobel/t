def add_quant_adaboost_model(lines, res, feature_min, feature_step):
    target = res["target"]
    final_model = res["final_model"]
    y_train = res["y_train_final"]

    fn = f"predict_{make_c_name(target)}"
    prefix = fn

    estimator, scaler = get_estimator_and_scaler(final_model)

    if scaler is not None:
        raise ValueError("AdaBoost export does not expect scaler.")

    y_min, y_step, _ = quantize_target_values(y_train)

    trees = [
        sklearn_tree_to_quantized_nodes(t, feature_min, feature_step, y_min, y_step)
        for t in estimator.estimators_
    ]

    weights = estimator.estimator_weights_.astype(float)

    n_trees = len(trees)

    lines.append(f"/* Quantized micro AdaBoostRegressor for {target} */")
    lines.append(f"#define {prefix.upper()}_N_TREES {n_trees}")
    lines.append(f"static const float {prefix}_y_min = {c_float(y_min)};")
    lines.append(f"static const float {prefix}_y_step = {c_float(y_step)};")
    lines.append(f"static const float {prefix}_weights[{prefix.upper()}_N_TREES] = {{{c_float_array(weights)}}};")
    lines.append("")

    for i, nodes in enumerate(trees):
        write_quant_tree_nodes(lines, f"{prefix}_tree_{i}", nodes)

    lines.append(f"static const FishQTreeNode* const {prefix}_trees[{prefix.upper()}_N_TREES] = {{")

    for i in range(n_trees):
        lines.append(f"    {prefix}_tree_{i},")

    lines.append("};")
    lines.append("")
    lines.append(f"float {fn}(const float input_raw[FISH_N_FEATURES]) {{")
    lines.append(f"    int16_t preds[{prefix.upper()}_N_TREES];")
    lines.append(f"    float weights[{prefix.upper()}_N_TREES];")
    lines.append(f"    for (int i = 0; i < {prefix.upper()}_N_TREES; i++) {{")
    lines.append(f"        preds[i] = fish_eval_q_tree_le({prefix}_trees[i], input_raw);")
    lines.append(f"        weights[i] = {prefix}_weights[i];")
    lines.append("    }")
    lines.append("")
    lines.append(f"    for (int i = 1; i < {prefix.upper()}_N_TREES; i++) {{")
    lines.append("        int16_t p = preds[i];")
    lines.append("        float w = weights[i];")
    lines.append("        int j = i - 1;")
    lines.append("        while (j >= 0 && preds[j] > p) {")
    lines.append("            preds[j + 1] = preds[j];")
    lines.append("            weights[j + 1] = weights[j];")
    lines.append("            j--;")
    lines.append("        }")
    lines.append("        preds[j + 1] = p;")
    lines.append("        weights[j + 1] = w;")
    lines.append("    }")
    lines.append("")
    lines.append("    float total_weight = 0.0f;")
    lines.append(f"    for (int i = 0; i < {prefix.upper()}_N_TREES; i++) total_weight += weights[i];")
    lines.append("    float threshold = 0.5f * total_weight;")
    lines.append("    float cumulative = 0.0f;")
    lines.append("    int16_t pred_q = preds[0];")
    lines.append(f"    for (int i = 0; i < {prefix.upper()}_N_TREES; i++) {{")
    lines.append("        cumulative += weights[i];")
    lines.append("        if (cumulative >= threshold) {")
    lines.append("            pred_q = preds[i];")
    lines.append("            break;")
    lines.append("        }")
    lines.append("    }")
    lines.append(f"    float pred = {prefix}_y_min + ((float)pred_q * {prefix}_y_step);")
    lines.append("    if (pred < 0.0f) pred = 0.0f;")
    lines.append("    return pred;")
    lines.append("}")
    lines.append("")


def add_quant_xgboost_model(lines, res, feature_min, feature_step):
    target = res["target"]
    final_model = res["final_model"]

