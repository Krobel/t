# ============================================================
# 4. MICRO-ENSEMBLE MODEL DEFINITIONS
# ============================================================

def make_small_adaboost():
    base_tree = DecisionTreeRegressor(
        max_depth=2,
        min_samples_leaf=8,
        random_state=42
    )

    # sklearn changed base_estimator -> estimator in newer versions.
    try:
        return AdaBoostRegressor(
            estimator=base_tree,
            n_estimators=10,
            learning_rate=0.05,
            random_state=42
        )
    except TypeError:
        return AdaBoostRegressor(
            base_estimator=base_tree,
            n_estimators=10,
            learning_rate=0.05,
            random_state=42
        )


def get_candidate_models():
    models = {
        "LinearRegression": Pipeline([
            ("scaler", StandardScaler()),
            ("model", LinearRegression())
        ]),

        # Single pruned tree
        "DecisionTree": DecisionTreeRegressor(
            max_depth=4,
            min_samples_leaf=8,
            random_state=42
        ),

        # Small KNN
        "KNN_k3": Pipeline([
            ("scaler", StandardScaler()),
            ("knn", KNeighborsRegressor(n_neighbors=3))
        ]),

        # Micro Random Forest
        "RandomForest": RandomForestRegressor(
            n_estimators=8,
            max_depth=3,
            min_samples_leaf=8,
            max_features=0.75,
            random_state=42,
            n_jobs=-1
        ),

        # Micro AdaBoost
        "AdaBoost": make_small_adaboost(),

        # Micro XGBoost
        "XGBoost": XGBRegressor(
            n_estimators=12,
            max_depth=2,
            learning_rate=0.05,
            min_child_weight=8,
            gamma=0.05,
            reg_lambda=10.0,
            subsample=0.8,
            colsample_bytree=0.8,
            objective="reg:squarederror",
            random_state=42,
            n_jobs=-1,
            verbosity=0
        ),
    }

    return models


# ============================================================
# 5. CROSS-VALIDATION
# ============================================================

def cv_predictions_for_model(model, X, y, n_splits=10, random_state=42):
    n_samples = len(y)
    effective_splits = min(n_splits, n_samples)

    if effective_splits < 2:
        raise ValueError("At least 2 samples are required for cross-validation.")

    kf = KFold(
        n_splits=effective_splits,
        shuffle=True,
        random_state=random_state
    )

    y_true_all = np.array(y, copy=True, dtype=float)
    y_pred_all = np.zeros_like(y_true_all, dtype=float)

    for train_idx, test_idx in kf.split(X):
        X_train, X_test = X[train_idx], X[test_idx]
        y_train = y[train_idx]

        m = clone(model)
        m.fit(X_train, y_train)

        y_pred = m.predict(X_test)
        y_pred_all[test_idx] = y_pred

    mae = mean_absolute_error(y_true_all, y_pred_all)
    rmse = np.sqrt(mean_squared_error(y_true_all, y_pred_all))
    r2 = r2_score(y_true_all, y_pred_all)

    return mae, rmse, r2, y_true_all, y_pred_all


def cv_metrics_for_models(models, X, y, n_splits=10, random_state=42):
    results = {}

    for name, model in models.items():
        try:
            mae, rmse, r2, _, _ = cv_predictions_for_model(
                model,
                X,
                y,
                n_splits=n_splits,
                random_state=random_state
            )

            results[name] = {
                "mae": mae,
                "rmse": rmse,
                "r2": r2,
                "failed": False,
                "error": ""
            }

        except Exception as e:
            results[name] = {
                "mae": np.nan,
                "rmse": np.nan,
                "r2": -np.inf,
                "failed": True,
                "error": str(e)
            }

    return results


def loo_evaluation(model, X, y):
    if len(y) < 2:
        raise ValueError("At least 2 samples are required for leave-one-out evaluation.")

    loo = LeaveOneOut()

    y_true_all = []
    y_pred_all = []

    for train_idx, test_idx in loo.split(X):
        X_train, X_test = X[train_idx], X[test_idx]
        y_train, y_test = y[train_idx], y[test_idx]

        m = clone(model)
        m.fit(X_train, y_train)

        y_pred = m.predict(X_test)

        y_true_all.append(float(y_test[0]))
        y_pred_all.append(float(y_pred[0]))

    y_true_all = np.array(y_true_all)
    y_pred_all = np.array(y_pred_all)

    mae = mean_absolute_error(y_true_all, y_pred_all)
    rmse = np.sqrt(mean_squared_error(y_true_all, y_pred_all))
    r2 = r2_score(y_true_all, y_pred_all)

    return mae, rmse, r2, y_true_all, y_pred_all


# ============================================================
# 6. NAMING AND C FORMAT HELPERS
# ============================================================

def make_c_name(name):
    name = str(name)
    name = re.sub(r"[^0-9a-zA-Z]+", "_", name)
    name = name.strip("_")

    if not re.match(r"^[A-Za-z_]", name):
        name = "x_" + name

    return name.lower()


def c_float(x):
    x = float(x)

    if np.isnan(x):
        return "0.0f"

    if np.isposinf(x):
        return "3.4028235e38f"

    if np.isneginf(x):
        return "-3.4028235e38f"

    s = f"{x:.9g}"

    if "." not in s and "e" not in s.lower():
        s += ".0"

    return s + "f"


def c_float_array(values):
    return ", ".join(c_float(v) for v in values)


def c_int_array(values):
    return ", ".join(str(int(v)) for v in values)


def get_estimator_and_scaler(fitted_model):
    scaler = None
    estimator = fitted_model

    if isinstance(fitted_model, Pipeline):
        for step_name, step_obj in fitted_model.steps:
            if isinstance(step_obj, StandardScaler):
                scaler = step_obj

        estimator = fitted_model.steps[-1][1]

    return estimator, scaler


# ============================================================
# 7. QUANTIZATION HELPERS
# ============================================================

def make_feature_quant_params(X):
    feature_min = X.min(axis=0)
    feature_max = X.max(axis=0)

    feature_step = (feature_max - feature_min) / 32767.0
    feature_step = np.where(feature_step == 0.0, 1.0, feature_step)

    return feature_min.astype(float), feature_step.astype(float)


def quantize_feature_value(x, f, feature_min, feature_step):
    q = int(round((float(x) - float(feature_min[f])) / float(feature_step[f])))

    if q < 0:
        q = 0

    if q > 32767:
        q = 32767

    return q


def quantize_target_values(y):
    y = np.asarray(y, dtype=float)

    y_min = float(np.min(y))
    y_max = float(np.max(y))

    y_step = (y_max - y_min) / 32767.0

    if y_step == 0.0:
        y_step = 1.0

    y_q = np.round((y - y_min) / y_step).astype(int)
    y_q = np.clip(y_q, 0, 32767).astype(np.int16)

    return y_min, y_step, y_q


def quantize_target_scalar(y_value, y_min, y_step):
    q = int(round((float(y_value) - float(y_min)) / float(y_step)))

    if q < 0:
        q = 0

    if q > 32767:
        q = 32767

    return q


def quantize_signed_scaled_array(X_scaled, multiplier=1000.0):
    Xq = np.round(X_scaled * multiplier).astype(int)
    Xq = np.clip(Xq, -32768, 32767).astype(np.int16)
    return Xq


# ============================================================
# 8. SKLEARN TREE EXTRACTION, QUANTIZED
# ============================================================

def sklearn_tree_to_quantized_nodes(tree_estimator, feature_min, feature_step, y_min, y_step):
    tree = tree_estimator.tree_

    children_left = tree.children_left
    children_right = tree.children_right
    feature = tree.feature
    threshold = tree.threshold
    value = tree.value.reshape(tree.value.shape[0], -1)[:, 0]

    nodes = []

    for i in range(tree.node_count):
        if children_left[i] == children_right[i]:
            nodes.append({
                "feature": -1,
                "threshold_q": 0,
                "left": -1,
                "right": -1,
                "value_q": quantize_target_scalar(value[i], y_min, y_step),
            })
        else:
            f = int(feature[i])

            nodes.append({
                "feature": f,
                "threshold_q": quantize_feature_value(
                    threshold[i],
                    f,
                    feature_min,
                    feature_step
                ),
                "left": int(children_left[i]),
                "right": int(children_right[i]),
                "value_q": 0,
            })

    return nodes


# ============================================================
# 9. XGBOOST TREE EXTRACTION, QUANTIZED
# ============================================================

def parse_xgb_base_score(xgb_model):
    booster = xgb_model.get_booster()
    config = json.loads(booster.save_config())

    raw = config["learner"]["learner_model_param"].get("base_score", "0")

    if isinstance(raw, str):
        raw = raw.strip()

        if raw.startswith("[") and raw.endswith("]"):
            raw = raw[1:-1]

    return float(raw)


def xgb_feature_index(split_name):
    split_name = str(split_name)

    if split_name.startswith("f"):
        return int(split_name[1:])

    raise ValueError(f"Unexpected XGBoost split name: {split_name}")


def xgb_json_tree_to_float_nodes(tree_dict):
    nodes = []

    def build(node):
        idx = len(nodes)

        nodes.append({
            "feature": -1,
            "threshold": 0.0,
            "left": -1,
            "right": -1,
            "value": 0.0,
        })

        if "leaf" in node:
            nodes[idx] = {
                "feature": -1,
                "threshold": 0.0,
                "left": -1,
                "right": -1,
                "value": float(node["leaf"]),
            }
            return idx

        children = {child["nodeid"]: child for child in node["children"]}

        yes_id = node["yes"]
        no_id = node["no"]

        left_idx = build(children[yes_id])
        right_idx = build(children[no_id])

        nodes[idx] = {
            "feature": xgb_feature_index(node["split"]),
            "threshold": float(node["split_condition"]),
            "left": left_idx,
            "right": right_idx,
            "value": 0.0,
        }

        return idx

    build(tree_dict)

    return nodes


def xgb_float_nodes_to_quantized_leaf_delta_nodes(nodes, feature_min, feature_step, leaf_min, leaf_step):
    qnodes = []

    for n in nodes:
        if n["feature"] < 0:
            qnodes.append({
                "feature": -1,
                "threshold_q": 0,
                "left": -1,
                "right": -1,
                "value_q": quantize_target_scalar(n["value"], leaf_min, leaf_step),
            })
        else:
            f = int(n["feature"])

            qnodes.append({
                "feature": f,
                "threshold_q": quantize_feature_value(
                    n["threshold"],
                    f,
                    feature_min,
                    feature_step
                ),
                "left": int(n["left"]),
                "right": int(n["right"]),
                "value_q": 0,
            })

    return qnodes


def collect_xgb_leaf_values(float_trees):
    vals = []

    for nodes in float_trees:
        for n in nodes:
            if n["feature"] < 0:
                vals.append(float(n["value"]))

    if len(vals) == 0:
        vals = [0.0]

    return np.array(vals, dtype=float)


# ============================================================
# 10. C HEADER WRITERS
# ============================================================

def write_quant_tree_nodes(lines, array_name, nodes):
    lines.append(f"static const FishQTreeNode {array_name}[] = {{")

    for n in nodes:
        lines.append(
            "    {"
            + f"{int(n['feature'])}, "
            + f"{int(n['threshold_q'])}, "
            + f"{int(n['left'])}, "
            + f"{int(n['right'])}, "
            + f"{int(n['value_q'])}"
            + "},"
        )

    lines.append("};")
    lines.append("")


def add_linear_model(lines, res):
    final_model = res["final_model"]
    target = res["target"]

    fn = f"predict_{make_c_name(target)}"
    prefix = fn

    estimator, scaler = get_estimator_and_scaler(final_model)

    if scaler is None:
        raise ValueError("LinearRegression export expects StandardScaler.")

    mean = scaler.mean_.astype(float)
    scale = scaler.scale_.astype(float)
    coef = estimator.coef_.astype(float)
    intercept = float(estimator.intercept_)

    lines.append(f"/* LinearRegression for {target} */")
    lines.append(f"static const float {prefix}_mean[FISH_N_FEATURES] = {{{c_float_array(mean)}}};")
    lines.append(f"static const float {prefix}_scale[FISH_N_FEATURES] = {{{c_float_array(scale)}}};")
    lines.append(f"static const float {prefix}_coef[FISH_N_FEATURES] = {{{c_float_array(coef)}}};")
    lines.append(f"static const float {prefix}_intercept = {c_float(intercept)};")
    lines.append("")
    lines.append(f"float {fn}(const float input_raw[FISH_N_FEATURES]) {{")
    lines.append(f"    float pred = {prefix}_intercept;")
    lines.append("    for (int i = 0; i < FISH_N_FEATURES; i++) {")
    lines.append(f"        float xs = (input_raw[i] - {prefix}_mean[i]) / {prefix}_scale[i];")
    lines.append(f"        pred += {prefix}_coef[i] * xs;")
    lines.append("    }")
    lines.append("    if (pred < 0.0f) pred = 0.0f;")
    lines.append("    return pred;")
    lines.append("}")
    lines.append("")


def add_quant_knn_model(lines, res, multiplier=1000.0):
    final_model = res["final_model"]
    target = res["target"]
    X_train_raw = res["X_train_final"]
    y_train = res["y_train_final"]

    fn = f"predict_{make_c_name(target)}"
    prefix = fn

    estimator, scaler = get_estimator_and_scaler(final_model)

    if scaler is None:
        raise ValueError("Quantized KNN export expects StandardScaler.")

    X_scaled = scaler.transform(X_train_raw).astype(float)
    Xq = quantize_signed_scaled_array(X_scaled, multiplier=multiplier)

    y_min, y_step, yq = quantize_target_values(y_train)

    k = int(estimator.n_neighbors)
    n_samples, n_features = Xq.shape

    lines.append(f"/* Quantized KNN_k{k} for {target} */")
    lines.append(f"#define {prefix.upper()}_N_SAMPLES {n_samples}")
    lines.append(f"#define {prefix.upper()}_K {k}")
    lines.append(f"static const float {prefix}_mean[FISH_N_FEATURES] = {{{c_float_array(scaler.mean_)}}};")
    lines.append(f"static const float {prefix}_scale[FISH_N_FEATURES] = {{{c_float_array(scaler.scale_)}}};")
    lines.append(f"static const float {prefix}_q_multiplier = {c_float(multiplier)};")
    lines.append(f"static const float {prefix}_y_min = {c_float(y_min)};")
    lines.append(f"static const float {prefix}_y_step = {c_float(y_step)};")
    lines.append("")
    lines.append(f"static const int16_t {prefix}_xq[{prefix.upper()}_N_SAMPLES][FISH_N_FEATURES] = {{")

    for row in Xq:
        lines.append("    {" + c_int_array(row) + "},")

    lines.append("};")
    lines.append("")
    lines.append(f"static const int16_t {prefix}_yq[{prefix.upper()}_N_SAMPLES] = {{{c_int_array(yq)}}};")
    lines.append("")
    lines.append(f"float {fn}(const float input_raw[FISH_N_FEATURES]) {{")
    lines.append("    int16_t input_q[FISH_N_FEATURES];")
    lines.append("    for (int j = 0; j < FISH_N_FEATURES; j++) {")
    lines.append(f"        float z = (input_raw[j] - {prefix}_mean[j]) / {prefix}_scale[j];")
    lines.append(f"        float qf = z * {prefix}_q_multiplier;")
    lines.append("        if (qf > 32767.0f) qf = 32767.0f;")
    lines.append("        if (qf < -32768.0f) qf = -32768.0f;")
    lines.append("        if (qf >= 0.0f) input_q[j] = (int16_t)(qf + 0.5f);")
    lines.append("        else input_q[j] = (int16_t)(qf - 0.5f);")
    lines.append("    }")
    lines.append("")
    lines.append(f"    long long best_dist[{prefix.upper()}_K];")
    lines.append(f"    int16_t best_yq[{prefix.upper()}_K];")
    lines.append(f"    for (int k = 0; k < {prefix.upper()}_K; k++) {{")
    lines.append("        best_dist[k] = 9223372036854775807LL;")
    lines.append("        best_yq[k] = 0;")
    lines.append("    }")
    lines.append("")
    lines.append(f"    for (int i = 0; i < {prefix.upper()}_N_SAMPLES; i++) {{")
    lines.append("        long long dist = 0;")
    lines.append("        for (int j = 0; j < FISH_N_FEATURES; j++) {")
    lines.append(f"            long long diff = (long long)input_q[j] - (long long){prefix}_xq[i][j];")
    lines.append("            dist += diff * diff;")
    lines.append("        }")
    lines.append("        int worst_index = 0;")
    lines.append("        long long worst_dist = best_dist[0];")
    lines.append(f"        for (int k = 1; k < {prefix.upper()}_K; k++) {{")
    lines.append("            if (best_dist[k] > worst_dist) {")
    lines.append("                worst_dist = best_dist[k];")
    lines.append("                worst_index = k;")
    lines.append("            }")
    lines.append("        }")
    lines.append("        if (dist < worst_dist) {")
    lines.append("            best_dist[worst_index] = dist;")
    lines.append(f"            best_yq[worst_index] = {prefix}_yq[i];")
    lines.append("        }")
    lines.append("    }")
    lines.append("")
    lines.append("    long sum_q = 0;")
    lines.append(f"    for (int k = 0; k < {prefix.upper()}_K; k++) sum_q += best_yq[k];")
    lines.append(f"    float avg_q = (float)sum_q / (float){prefix.upper()}_K;")
    lines.append(f"    float pred = {prefix}_y_min + (avg_q * {prefix}_y_step);")
    lines.append("    if (pred < 0.0f) pred = 0.0f;")
    lines.append("    return pred;")
    lines.append("}")
    lines.append("")


def add_quant_decision_tree_model(lines, res, feature_min, feature_step):
    target = res["target"]
    final_model = res["final_model"]
    y_train = res["y_train_final"]

    fn = f"predict_{make_c_name(target)}"
    prefix = fn

    estimator, scaler = get_estimator_and_scaler(final_model)

    if scaler is not None:
        raise ValueError("DecisionTree export does not expect scaler.")

    y_min, y_step, _ = quantize_target_values(y_train)

    nodes = sklearn_tree_to_quantized_nodes(
        estimator,
        feature_min,
        feature_step,
        y_min,
        y_step
    )

    lines.append(f"/* Quantized pruned DecisionTree for {target} */")
    lines.append(f"static const float {prefix}_y_min = {c_float(y_min)};")
    lines.append(f"static const float {prefix}_y_step = {c_float(y_step)};")
    write_quant_tree_nodes(lines, f"{prefix}_tree", nodes)

    lines.append(f"float {fn}(const float input_raw[FISH_N_FEATURES]) {{")
    lines.append(f"    int16_t yq = fish_eval_q_tree_le({prefix}_tree, input_raw);")
    lines.append(f"    float pred = {prefix}_y_min + ((float)yq * {prefix}_y_step);")
    lines.append("    if (pred < 0.0f) pred = 0.0f;")
    lines.append("    return pred;")
    lines.append("}")
    lines.append("")


def add_quant_random_forest_model(lines, res, feature_min, feature_step):
