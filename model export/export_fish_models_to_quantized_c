def add_header_preamble(lines, feature_min, feature_step):
    lines.append("#ifndef FISH_COMPACT_MODELS_H")
    lines.append("#define FISH_COMPACT_MODELS_H")
    lines.append("")
    lines.append("#include <stdint.h>")
    lines.append("#include <math.h>")
    lines.append("")
    lines.append("/*")
    lines.append("Compact pruned + quantized embedded models for fish-tank data.")
    lines.append("Generated from Colab.")
    lines.append("")
    lines.append("Input order:")
    lines.append("input_raw[0] = DO_F(mg/L)")
    lines.append("input_raw[1] = ORP_F(mV)")
    lines.append("input_raw[2] = pH_F")
    lines.append("input_raw[3] = Temp_F(C)")
    lines.append("")
    lines.append("Targets:")
    lines.append("TAN_F(mg/L)")
    lines.append("TOC_F(mg/L)")
    lines.append("DOC_F(mg/L)")
    lines.append("TN_F(mg/L)")
    lines.append("DN_F(mg/L)")
    lines.append("")
    lines.append("Deployment optimization:")
    lines.append("- Micro RandomForest, AdaBoost, and XGBoost")
    lines.append("- Shallow tree depth")
    lines.append("- Increased minimum leaf size")
    lines.append("- int16_t quantized tree thresholds")
    lines.append("- int16_t quantized tree/KNN outputs")
    lines.append("- int16_t quantized KNN feature matrix")
    lines.append("*/")
    lines.append("")
    lines.append("#define FISH_N_FEATURES 4")
    lines.append("")
    lines.append(f"static const float fish_feature_min[FISH_N_FEATURES] = {{{c_float_array(feature_min)}}};")
    lines.append(f"static const float fish_feature_step[FISH_N_FEATURES] = {{{c_float_array(feature_step)}}};")
    lines.append("")
    lines.append("typedef struct {")
    lines.append("    int16_t feature;")
    lines.append("    int16_t threshold_q;")
    lines.append("    int16_t left;")
    lines.append("    int16_t right;")
    lines.append("    int16_t value_q;")
    lines.append("} FishQTreeNode;")
    lines.append("")
    lines.append("static int16_t fish_quantize_feature(float x, int16_t f) {")
    lines.append("    if (!isfinite(x)) return 0;")
    lines.append("    float qf = (x - fish_feature_min[f]) / fish_feature_step[f];")
    lines.append("    if (qf < 0.0f) qf = 0.0f;")
    lines.append("    if (qf > 32767.0f) qf = 32767.0f;")
    lines.append("    return (int16_t)(qf + 0.5f);")
    lines.append("}")
    lines.append("")
    lines.append("static int16_t fish_eval_q_tree_le(const FishQTreeNode *nodes, const float *input) {")
    lines.append("    int16_t node = 0;")
    lines.append("    while (nodes[node].feature >= 0) {")
    lines.append("        int16_t f = nodes[node].feature;")
    lines.append("        int16_t xq = fish_quantize_feature(input[f], f);")
    lines.append("        if (xq <= nodes[node].threshold_q) node = nodes[node].left;")
    lines.append("        else node = nodes[node].right;")
    lines.append("    }")
    lines.append("    return nodes[node].value_q;")
    lines.append("}")
    lines.append("")
    lines.append("static int16_t fish_eval_q_tree_lt(const FishQTreeNode *nodes, const float *input) {")
    lines.append("    int16_t node = 0;")
    lines.append("    while (nodes[node].feature >= 0) {")
    lines.append("        int16_t f = nodes[node].feature;")
    lines.append("        int16_t xq = fish_quantize_feature(input[f], f);")
    lines.append("        if (xq < nodes[node].threshold_q) node = nodes[node].left;")
    lines.append("        else node = nodes[node].right;")
    lines.append("    }")
    lines.append("    return nodes[node].value_q;")
    lines.append("}")
    lines.append("")


def create_combined_header(results, export_dir, header_name, feature_min, feature_step):
    header_path = os.path.join(export_dir, header_name)

    lines = []
    add_header_preamble(lines, feature_min, feature_step)

    for res in results:
        model_name = res["best_model_name"]

        lines.append("")
        lines.append("/* ============================================================")
        lines.append(f"   Target: {res['target']}")
        lines.append(f"   Selected model: {model_name}")
        lines.append("   ============================================================ */")
        lines.append("")

        if model_name == "LinearRegression":
            add_linear_model(lines, res)

        elif model_name == "KNN_k3":
            add_quant_knn_model(lines, res)

        elif model_name == "DecisionTree":
            add_quant_decision_tree_model(lines, res, feature_min, feature_step)

        elif model_name == "RandomForest":
            add_quant_random_forest_model(lines, res, feature_min, feature_step)

        elif model_name == "AdaBoost":
            add_quant_adaboost_model(lines, res, feature_min, feature_step)

        elif model_name == "XGBoost":
            add_quant_xgboost_model(lines, res, feature_min, feature_step)

        else:
            raise ValueError(f"No deployment exporter for model: {model_name}")

    lines.append("")
    lines.append("#endif")
    lines.append("")

    with open(header_path, "w") as f:
        f.write("\n".join(lines))

    return header_path


def validate_header(header_path):
    with open(header_path, "r") as f:
        text = f.read()

    print("\nHeader validation:")
    print("Header path:", header_path)
    print("Number of #ifndef:", text.count("#ifndef"))
    print("Number of #endif:", text.count("#endif"))

    if text.count("#ifndef") != 1 or text.count("#endif") != 1:
        raise ValueError("Header guard problem.")

    bad_predict_guards = re.findall(r"#ifndef\s+PREDICT_[A-Z0-9_]+_H", text)
    bad_float_literals = re.findall(r'(?<![A-Za-z0-9_.+\-])(-?\d+)f\b', text)

    print("Bad nested PREDICT guards:", len(bad_predict_guards))
    print("Bad float literals like 0f:", len(bad_float_literals))

    if bad_predict_guards:
        print("Examples:", bad_predict_guards[:10])
        raise ValueError("Old nested PREDICT header guards found.")

    if bad_float_literals:
        print("Examples:", bad_float_literals[:10])
        raise ValueError("Invalid float literals found.")

    size_kb = os.path.getsize(header_path) / 1024.0
    size_mb = size_kb / 1024.0

    print(f"Header size: {size_kb:.1f} kB ({size_mb:.3f} MB)")
    print(f"Header lines: {len(text.splitlines())}")
    print("Header validation passed.")


