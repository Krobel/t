    y_min, y_step, _ = quantize_target_values(y_train)

    trees = [
        sklearn_tree_to_quantized_nodes(t, feature_min, feature_step, y_min, y_step)
        for t in estimator.estimators_
    ]

    n_trees = len(trees)

    lines.append(f"/* Quantized micro RandomForest for {target} */")
    lines.append(f"#define {prefix.upper()}_N_TREES {n_trees}")
    lines.append(f"static const float {prefix}_y_min = {c_float(y_min)};")
    lines.append(f"static const float {prefix}_y_step = {c_float(y_step)};")
    lines.append("")

    for i, nodes in enumerate(trees):
        write_quant_tree_nodes(lines, f"{prefix}_tree_{i}", nodes)

    lines.append(f"static const FishQTreeNode* const {prefix}_trees[{prefix.upper()}_N_TREES] = {{")

    for i in range(n_trees):
        lines.append(f"    {prefix}_tree_{i},")

    lines.append("};")
    lines.append("")
    lines.append(f"float {fn}(const float input_raw[FISH_N_FEATURES]) {{")
    lines.append("    long sum_q = 0;")
    lines.append(f"    for (int i = 0; i < {prefix.upper()}_N_TREES; i++) {{")
    lines.append(f"        sum_q += fish_eval_q_tree_le({prefix}_trees[i], input_raw);")
    lines.append("    }")
    lines.append(f"    float avg_q = (float)sum_q / (float){prefix.upper()}_N_TREES;")
    lines.append(f"    float pred = {prefix}_y_min + (avg_q * {prefix}_y_step);")
    lines.append("    if (pred < 0.0f) pred = 0.0f;")
    lines.append("    return pred;")
    lines.append("}")
