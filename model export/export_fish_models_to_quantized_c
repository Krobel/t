def select_best_model_by_r2(cv_metrics):
    valid_models = {}

    for name, vals in cv_metrics.items():
        if name in EXPORTABLE_MODELS:
            if not vals["failed"] and np.isfinite(vals["r2"]):
                valid_models[name] = vals

    if not valid_models:
        raise ValueError("No valid exportable model was available.")

    best_name = max(valid_models, key=lambda nm: valid_models[nm]["r2"])

    return best_name


def run_pipeline_target(df, feature_cols, target_col, n_splits=10):
    sub_df = df[feature_cols + [target_col]].dropna()

    if sub_df.empty:
        raise ValueError(f"No valid rows found for target: {target_col}")

    X = sub_df[feature_cols].values.astype(float)
    y = sub_df[target_col].values.astype(float)

    if len(y) < 2:
        raise ValueError(f"Not enough samples for target: {target_col}")

    models = get_candidate_models()

    cv_metrics = cv_metrics_for_models(
        models,
        X,
        y,
        n_splits=n_splits,
        random_state=42
    )

    print("\n" + "=" * 70)
    print(f"Target: {target_col}")
    print(f"Valid samples: {len(y)}")
    print("=" * 70)

    print("\n10-fold CV mean metrics:")
    print("  Model            |  MAE   |  RMSE  |   R2")
    print("  " + "-" * 55)

    for name, m in sorted(cv_metrics.items(), key=lambda kv: kv[1]["r2"], reverse=True):
        if m["failed"]:
            print(f"  {name:16s} |   NA   |   NA   |   NA")
            print(f"      Error: {m['error']}")
        else:
            print(
                f"  {name:16s} | "
                f"{m['mae']:6.3f} | "
                f"{m['rmse']:6.3f} | "
                f"{m['r2']:6.3f}"
            )

    best_name = select_best_model_by_r2(cv_metrics)
    best_model = models[best_name]

    print(f"\nSelected deployment model for {target_col}: {best_name}")

    mae_cv_best, rmse_cv_best, r2_cv_best, y_true_cv, y_pred_cv = cv_predictions_for_model(
        best_model,
        X,
        y,
        n_splits=n_splits,
        random_state=42
    )

    mae_loo, rmse_loo, r2_loo, y_true_loo, y_pred_loo = loo_evaluation(
        best_model,
        X,
        y
    )

    print("\nSelected model 10-fold CV:")
    print(f"  MAE  = {mae_cv_best:.3f}")
    print(f"  RMSE = {rmse_cv_best:.3f}")
    print(f"  R2   = {r2_cv_best:.3f}")

    print("\nSelected model LOO:")
    print(f"  MAE  = {mae_loo:.3f}")
    print(f"  RMSE = {rmse_loo:.3f}")
    print(f"  R2   = {r2_loo:.3f}")

    final_model = clone(best_model)
    final_model.fit(X, y)

    return {
        "target": target_col,
        "n_samples": len(y),
        "best_model_name": best_name,
        "cv_metrics": cv_metrics,
        "cv_best_mae": mae_cv_best,
        "cv_best_rmse": rmse_cv_best,
        "cv_best_r2": r2_cv_best,
        "y_true_cv": y_true_cv,
        "y_pred_cv": y_pred_cv,
        "loo_mae": mae_loo,
        "loo_rmse": rmse_loo,
        "loo_r2": r2_loo,
        "y_true_loo": y_true_loo,
        "y_pred_loo": y_pred_loo,
        "final_model": final_model,
        "feature_cols": feature_cols,
        "X_train_final": X,
        "y_train_final": y,
    }


