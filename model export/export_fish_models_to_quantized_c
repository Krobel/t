        "--input-excel",
        required=True,
        help="Path to the Excel workbook containing the fish-tank data."
    )
    parser.add_argument(
        "--sheet-name",
        default="Fish tank",
        help="Excel sheet name to load. Default: Fish tank."
    )
    parser.add_argument(
        "--output-dir",
        default="exports/fish_c_models_micro_quantized",
        help="Directory where the generated header and summary CSV files will be written."
    )
    parser.add_argument(
        "--header-name",
        default="fish_compact_models.h",
        help="Name of the combined Arduino C/C++ header file."
    )
    parser.add_argument(
        "--keep-old-exports",
        action="store_true",
        help="Keep existing files in the output directory instead of clearing it first."
    )
    return parser.parse_args()


args = parse_args()

